# Database (SQLite by default; use PostgreSQL in shared environments)
DATABASE_URL=sqlite:///./fincrime_recon.db
# DATABASE_URL=postgresql+psycopg2://recon:recon@localhost:5432/recon

JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=480
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# Optional AI providers - without these the assistant uses the built-in grounded engine
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
ANTHROPIC_API_KEY=

# Reconciliation
NUMERIC_TOLERANCE=0.0
CRITICAL_VARIANCE_AMOUNT=10000
